rules_version = '2';
service cloud.firestore {
    match /databases/{database}/documents {

        // Helpers
        function isSignedIn() {
            return request.auth != null;
        }

        function isAdmin() {
            return isSignedIn() && 
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
        }

        // Users: you can create and read your own profile, but you can't pick your own role
        match /users/{userId} {
            allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
            allow create: if isSignedIn() && request.auth.uid == userId &&
                request.resource.data.role == 'student';
            allow update, delete: if isAdmin();
        }

        // items (the catalog): everyone signed in can look, only admins can modify
        match /items/{itemId} {
            allow read: if isSignedIn();
            allow write: if isAdmin();
        }

        // Borrower's slip
        match /slips/{slipId} {
            allow read: 
                if isSignedIn() && 
                (resource.data.createdBy == request.auth.uid || isAdmin());
            allow create: 
                if isSignedIn()
                && request.resource.data.createdBy == request.auth.uid
                && request.resource.data.status == 'submitted';
            allow update: if isAdmin();
            allow delete: if false;
        }

        // Surveys: anyone signed in can submit one, only admins can read them
        match /surveys/{surveyId} {
            allow create: if isSignedIn();
            allow read: if isAdmin();
            allow update, delete: if false;
        }

        // config (survey questions): anyone signed in can read, only admins can edit
        match /config/{docId} {
            allow read: if isSignedIn();
            allow write: if isAdmin();
        }
    }
}